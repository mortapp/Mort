# EXPO_PUBLIC_* variables are client-safe when Supabase RLS is enabled and least-privilege grants are configured.
# Real values belong in local .env/.env.local files or hosting dashboards, not in this example file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ENV=
EXPO_PUBLIC_PROJECT_ID=

# RevenueCat public SDK keys only. Never put RevenueCat secret keys in Expo/mobile code.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_PLUS=mort_plus
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_PREMIUM=mort_plus
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_AD_FREE=mort_ad_free
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ADULT_PRO=mort_adult_pro
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_BUSINESS_BOOST=mort_job_boost
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_GUARDIAN_PLUS=mort_guardian_plus
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_LIFETIME=mort_lifetime
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_PROFILE_STYLE_PACK=mort_profile_style_pack
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_USERNAME_CHANGE_TOKEN=mort_username_change_token
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_JOB_BOOST=mort_job_boost

# AdMob public app/ad unit identifiers. Use test ads in development and do not enable ads before consent/legal review.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-9412242686563958~6217664808
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_AD_UNIT_ID=ca-app-pub-9412242686563958/2438237282
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_AD_UNIT_ID=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_AD_UNIT_ID=ca-app-pub-9412242686563958/1223146979
EXPO_PUBLIC_ADMOB_IOS_NATIVE_AD_UNIT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_AD_UNIT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_AD_UNIT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_AD_UNIT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_NATIVE_AD_UNIT_ID=

EXPO_PUBLIC_ADS_ENABLED=false
EXPO_PUBLIC_IAP_ENABLED=false
EXPO_PUBLIC_USE_TEST_ADS=true

# Server-only secrets are intentionally not listed here. Configure them only in
# Supabase/Edge Function server environments or local uncommitted shells.

# Local/staging QA helpers. Do not use the current mismatched live project for QA smoke tests.
MORT_QA_TARGET=
MORT_QA_ALLOW_SERVICE_ROLE=
MORT_QA_ALLOW_PUSH_INVOKE=
MORT_LOCAL_SUPABASE_CONFIRM=
MORT_CONFIRM_FRESH_SUPABASE=
MORT_SUPABASE_PROJECT_REF=
MORT_CONFIRM_PROJECT_REF=

IOS_BUNDLE_IDENTIFIER=com.mortapp.mobile
ANDROID_PACKAGE_NAME=com.mortapp.mobile
PROOF_UPLOAD_BUCKET=proof-uploads
VERIFICATION_UPLOAD_BUCKET=verification-uploads
REPORT_UPLOAD_BUCKET=report-uploads
