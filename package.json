{
  "name": "mort-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "MORT teen-safe local hustle marketplace for iOS-first Expo React Native and Supabase.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web",
    "lint": "expo lint",
    "qa:smoke": "node scripts/qa-smoke.mjs",
    "qa:rls": "node scripts/qa-rls.mjs",
    "qa:old-project-smoke": "node scripts/qa-old-project-smoke.mjs",
    "qa:old-project-rls": "node scripts/qa-old-project-rls.mjs",
    "qa:create-local-users": "node scripts/create-local-test-users.mjs",
    "expo:doctor": "npx expo-doctor",
    "supabase:types:local": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-supabase-types.ps1",
    "supabase:types": "supabase gen types typescript --linked > types/supabase.generated.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.3.8",
    "@supabase/supabase-js": "^2.110.1",
    "expo": "^57.0.8",
    "expo-constants": "^57.0.7",
    "expo-dev-client": "^57.0.8",
    "expo-device": "^57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "^57.0.6",
    "expo-linking": "^57.0.4",
    "expo-notifications": "^57.0.7",
    "expo-router": "^57.0.8",
    "expo-secure-store": "^57.0.1",
    "expo-status-bar": "^57.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.0",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-purchases": "^10.4.1",
    "react-native-purchases-ui": "^10.4.1",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.0",
    "pg": "^8.22.0",
    "supabase": "^2.109.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "uuid": ">=11.1.1"
    }
  }
}
