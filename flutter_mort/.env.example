SUPABASE_URL=
SUPABASE_ANON_KEY=

# Release scripts own the final values. Google stays off unless an approved
# profile explicitly enables it with this exact native callback.
GOOGLE_AUTH_ENABLED=false
MORT_AUTH_REDIRECT_URL=com.mortapp.mobile://app/auth-callback
MORT_RELEASE_PROFILE=development
MORT_RELEASE_STAGE=development
MORT_OPERATIONAL_MODE=development
MORT_PUBLIC_MARKETPLACE_ENABLED=false
MORT_MARKETPLACE_PAYMENTS_ENABLED=false
MORT_PAYMENT_PROVIDER_MODE=disabled
MORT_IDENTITY_VERIFICATION_ENABLED=false
MORT_REMOTE_PUSH_ENABLED=false
MORT_CRASH_REPORTING_ENABLED=false
MORT_SUPPORT_AI_ENABLED=false
MORT_DETERMINISTIC_SUPPORT_ENABLED=true
MORT_PUBLIC_ACTIVATION_APPROVED=false
MORT_SUPPORT_ROUTE=/support
MORT_ADMIN_ROUTE=/admin/home
MORT_TERMS_VERSION=draft-2026-07
MORT_PRIVACY_VERSION=draft-2026-07
MORT_COMMUNITY_GUIDELINES_VERSION=draft-2026-07
MORT_SAFETY_RULES_VERSION=draft-2026-07
MORT_MINIMUM_SUPPORTED_APP_VERSION=0.9.11
MORT_MAINTENANCE_MODE=false
MORT_DEBUG_ENDPOINTS_ENABLED=false
PLAY_REVIEW_MODE_ENABLED=false

REVENUECAT_FLUTTER_IOS_SDK_KEY=
REVENUECAT_FLUTTER_ANDROID_SDK_KEY=
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=
REVENUECAT_ENTITLEMENT_PLUS=mort_plus
REVENUECAT_ENTITLEMENT_AD_FREE=mort_ad_free
REVENUECAT_ENTITLEMENT_ADULT_PRO=mort_adult_pro
REVENUECAT_ENTITLEMENT_GUARDIAN_PLUS=mort_guardian_plus
REVENUECAT_ENTITLEMENT_USERNAME_TOKEN=mort_username_change_token
REVENUECAT_ENTITLEMENT_JOB_BOOST=mort_job_boost
REVENUECAT_ENTITLEMENT_PROFILE_STYLE_PACK=mort_profile_style_pack

# No iOS AdMob app has been created yet -- left blank rather than a stale
# placeholder from an earlier, unrelated prototype. app_config.dart has no
# compiled-in default for these either, so ads stay correctly inert on iOS
# until a real iOS AdMob app exists.
ADMOB_IOS_APP_ID=
ADMOB_IOS_BANNER_AD_UNIT_ID=
ADMOB_IOS_REWARDED_AD_UNIT_ID=
ADMOB_IOS_INTERSTITIAL_AD_UNIT_ID=
ADMOB_IOS_NATIVE_AD_UNIT_ID=

# Real, confirmed Android AdMob app (publisher pub-9883419411387958) --
# also baked in as app_config.dart's compiled-in defaults, so these only
# need to be set explicitly to override them (e.g. for a different AdMob
# account in a fork).
ADMOB_ANDROID_APP_ID=ca-app-pub-9883419411387958~1048817736
ADMOB_ANDROID_BANNER_AD_UNIT_ID=ca-app-pub-9883419411387958/8216077490
ADMOB_ANDROID_REWARDED_AD_UNIT_ID=ca-app-pub-9883419411387958/1877899853
ADMOB_ANDROID_INTERSTITIAL_AD_UNIT_ID=
ADMOB_ANDROID_NATIVE_AD_UNIT_ID=

ADS_ENABLED=false
USE_TEST_ADS=true
IAP_ENABLED=false
