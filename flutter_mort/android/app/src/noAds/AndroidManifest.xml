<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <application>
        <!-- The Ads dependency is still linked. Do not let native entry points
             initialize it before the Dart release and consent gates. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" tools:node="remove" />
        <provider android:name="com.google.android.gms.ads.MobileAdsInitProvider" tools:node="remove" />
        <activity android:name="com.google.android.gms.ads.AdActivity" tools:node="remove" />
        <activity android:name="com.google.android.gms.ads.OutOfContextTestingActivity" tools:node="remove" />
        <activity android:name="com.google.android.gms.ads.NotificationHandlerActivity" tools:node="remove" />
        <service android:name="com.google.android.gms.ads.AdService" tools:node="remove" />
        <property android:name="android.adservices.AD_SERVICES_CONFIG" tools:node="remove" />
    </application>
</manifest>
