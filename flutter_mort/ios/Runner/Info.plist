<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MORT</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MORT</string>
	<key>NSCameraUsageDescription</key>
	<string>MORT lets you capture job proof, a profile photo, or a safety report attachment when you choose that action.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>MORT uses Face ID only to unlock private app content and confirm sensitive account actions on this device.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>MORT can use your location while the app is open to select a general job-search area. Exact coordinates are not shown in the public job feed.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MORT lets you select job proof, a profile photo, or a safety report attachment from your photo library.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>MORT sends safety, guardian approval, application, and message notifications.</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Google Mobile Ads SDK (google_mobile_ads, compiled in via
	     AppConfig.nativeAdsCompiledIn) hard-requires this key to be present
	     at process launch -- it crashes with GADInvalidInitializationException
	     ("initialized without an application ID") on every real device
	     otherwise, regardless of the ADS_ENABLED dart-define, because the
	     native SDK's own launch-time check runs independent of whether Dart
	     ever calls MobileAds.instance.initialize(). No real iOS AdMob app has
	     been created yet (see .env.example / MORT_EXTERNAL_RELEASE_GATES.md),
	     so this uses Google's own official public sample App ID -- the same
	     placeholder Google publishes for pre-launch integration testing, not
	     a fabricated identifier -- exactly mirroring this codebase's existing
	     use of Google's sample ad-unit IDs when USE_TEST_ADS is true. Replace
	     with the real MORT iOS AdMob App ID once one is created. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mortapp.mobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.mortapp.mobile</string>
			</array>
		</dict>
	</array>
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
